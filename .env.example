# 삼성코칭동호회(SCC) Dream Milestone 포털 환경변수 설정 예시
# 로컬 개발 시 미설정하면 데모 비밀번호(scc2026)로 동작하며, Netlify 배포 시 Environment Variables에 등록합니다.

COACH_SHARED_PASSWORD=scc2026
SESSION_HMAC_SECRET=scc-dream-milestone-hmac-secret-change-in-production-2026

# 구글폼 3종 URL (1~4회기 통합 코칭일지, 5회기 코치 성과평가, 5회기 학생 성과평가)
NEXT_PUBLIC_FORM_LOG_URL=
NEXT_PUBLIC_FORM_LOG_SESSION_ENTRY=entry.session
NEXT_PUBLIC_FORM_COACH_EVAL_URL=
NEXT_PUBLIC_FORM_STUDENT_EVAL_URL=

# 구글드라이브 리소스 5종 공유 URL
NEXT_PUBLIC_DRIVE_FULL_GUIDE_URL=
NEXT_PUBLIC_DRIVE_PRE_SHEET_URL=
NEXT_PUBLIC_DRIVE_WORKBOOK_URL=
NEXT_PUBLIC_DRIVE_OT_MANUAL_URL=
NEXT_PUBLIC_DRIVE_QUESTION_CARDS_URL=
